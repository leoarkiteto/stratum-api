package electiontemplates

import (
	"github.com/leoarkiteto/stratum/internal/model"
	"github.com/leoarkiteto/stratum/internal/web/templates"
)

templ DetailPage(user *model.User, v *model.ElectionView, csrf string, errMsg string) {
	@templates.Base("Election", user) {
		@DetailSection(v, csrf, errMsg)
	}
}

templ DetailSection(v *model.ElectionView, csrf string, errMsg string) {
	<div id="election-detail" class="space-y-8">
		<div>
			<div class="flex flex-wrap items-center gap-3">
				<h1 class="text-2xl font-semibold tracking-tight">{ v.Election.Title }</h1>
				@StatusBadge(v.Election.Status)
			</div>
			if v.Election.Description != "" {
				<p class="mt-2 text-slate-600">{ v.Election.Description }</p>
			}
			<p class="mt-2 text-sm text-slate-500">Created by { v.Election.CreatorName } on { v.Election.CreatedAt.Format("Jan 2, 2006") }.</p>
			if errMsg != "" {
				<div class="mt-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">{ errMsg }</div>
			}
		</div>

		if v.Election.Status == model.ElectionStatusClosed {
			@Results(v)
		} else if v.Election.Status == model.ElectionStatusTransition {
			@Transition(v)
		} else {
			@CandidateList(v)
		}

		@PhaseActions(v, csrf)
	</div>
}

templ CandidateList(v *model.ElectionView) {
	<div>
		<h2 class="text-lg font-semibold tracking-tight">Candidates</h2>
		if len(v.Candidates) == 0 {
			<p class="mt-2 text-sm text-slate-600">No candidates have registered yet.</p>
		} else {
			<ul class="mt-4 space-y-3">
				for _, c := range v.Candidates {
					<li class="rounded-md border border-slate-200 bg-white px-4 py-3">
						<p class="font-medium">{ c.Name }</p>
						if c.Statement != "" {
							<p class="mt-1 text-sm text-slate-600">{ c.Statement }</p>
						}
					</li>
				}
			</ul>
		}
	</div>
}

templ Results(v *model.ElectionView) {
	<div>
		<h2 class="text-lg font-semibold tracking-tight">Results</h2>
		if v.Election.WinnerID != nil {
			<div class="mt-2 rounded-md border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800">
				Winner: { v.Election.WinnerName }
			</div>
		} else {
			<div class="mt-2 rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
				No winner — the vote was tied or no votes were cast.
			</div>
		}
		@ResultsTable(v)
	</div>
}

templ Transition(v *model.ElectionView) {
	<div>
		<h2 class="text-lg font-semibold tracking-tight">Handover</h2>
		<div class="mt-2 rounded-md border border-indigo-200 bg-indigo-50 px-4 py-3 text-sm text-indigo-900">
			<p><span class="font-medium">{ v.Election.WinnerName }</span> won the election and takes office as syndic on <span class="font-medium">{ fmtDate(v.Election.TransitionEndsAt) }</span>.</p>
			<p class="mt-1 text-indigo-700">The current syndic stays in office until then, handing over documents and contacts.</p>
		</div>
		@ResultsTable(v)
	</div>
}

templ ResultsTable(v *model.ElectionView) {
	<table class="mt-4 w-full overflow-hidden rounded-md border border-slate-200 bg-white text-sm">
		<thead>
			<tr class="border-b border-slate-200 text-left text-slate-500">
				<th class="px-4 py-2 font-medium">Candidate</th>
				<th class="px-4 py-2 font-medium">Votes</th>
			</tr>
		</thead>
		<tbody>
			for _, t := range v.Tallies {
				<tr class="border-b border-slate-100 last:border-0">
					<td class="px-4 py-2">{ t.Candidate.Name }</td>
					<td class="px-4 py-2">{ t.Votes }</td>
				</tr>
			}
		</tbody>
	</table>
}

templ PhaseActions(v *model.ElectionView, csrf string) {
	if v.Election.Status == model.ElectionStatusNomination {
		if v.CanRegister {
			@RegisterForm(v.Election.ID, csrf)
		} else if v.IsCandidate {
			<form hx-post="/elections/{ v.Election.ID }/candidates/withdraw" hx-target="#election-detail" hx-swap="outerHTML" method="post" class="mt-6 rounded-md border border-slate-200 bg-white p-4">
				<input type="hidden" name="csrf" value={ csrf }/>
				<p class="text-sm text-slate-600">You are registered as a candidate in this election.</p>
				<button type="submit" class="mt-3 rounded-md border border-slate-300 px-3 py-1.5 text-sm font-medium hover:bg-slate-50">Withdraw candidacy</button>
			</form>
		} else if !v.IsOwner {
			<p class="mt-6 text-sm text-slate-600">Only owners and the current syndic can run for syndic.</p>
		}
		if v.CanOpenVoting {
			<form hx-post="/elections/{ v.Election.ID }/open-voting" hx-target="#election-detail" hx-swap="outerHTML" method="post" class="mt-6 rounded-md border border-slate-200 bg-white p-4">
				<input type="hidden" name="csrf" value={ csrf }/>
				<p class="text-sm text-slate-600">Close nominations and open voting to owners.</p>
				<button type="submit" class="mt-3 rounded-md bg-slate-900 px-3 py-1.5 text-sm font-semibold text-white hover:bg-slate-700">Open voting</button>
			</form>
		}
	} else if v.Election.Status == model.ElectionStatusVoting {
		if v.CanVote {
			@VoteForm(v.Election.ID, v.Candidates, csrf)
		} else if v.HasVoted {
			<div class="mt-6 rounded-md border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">Your vote has been recorded. It cannot be changed.</div>
		} else if !v.IsOwner {
			<p class="mt-6 text-sm text-slate-600">Only owners can vote in this election.</p>
		}
		if v.CanClose {
			<form hx-post="/elections/{ v.Election.ID }/close" hx-target="#election-detail" hx-swap="outerHTML" method="post" class="mt-6 rounded-md border border-slate-200 bg-white p-4">
				<input type="hidden" name="csrf" value={ csrf }/>
				<p class="text-sm text-slate-600">Close the election and count the votes. The winner takes office after the { v.Election.TransitionDays }-day handover period.</p>
				<button type="submit" class="mt-3 rounded-md bg-slate-900 px-3 py-1.5 text-sm font-semibold text-white hover:bg-slate-700">Close election and count votes</button>
			</form>
		}
	}
}

templ RegisterForm(electionID int64, csrf string) {
	<form id="register-form" hx-post="/elections/{ electionID }/candidates" hx-target="#election-detail" hx-swap="outerHTML" method="post" class="mt-6 rounded-md border border-slate-200 bg-white p-4">
		<input type="hidden" name="csrf" value={ csrf }/>
		<h3 class="font-medium">Run for syndic</h3>
		<textarea name="statement" rows="3" maxlength="1000" placeholder="Why should residents vote for you? (optional)"
			class="mt-2 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none"></textarea>
		<button type="submit" class="mt-3 rounded-md bg-slate-900 px-3 py-1.5 text-sm font-semibold text-white hover:bg-slate-700">Register as candidate</button>
	</form>
}

templ VoteForm(electionID int64, candidates []model.Candidate, csrf string) {
	<form id="vote-form" hx-post="/elections/{ electionID }/vote" hx-target="#election-detail" hx-swap="outerHTML" method="post" class="mt-6 rounded-md border border-slate-200 bg-white p-4">
		<input type="hidden" name="csrf" value={ csrf }/>
		<h3 class="font-medium">Cast your vote</h3>
		<div class="mt-3 space-y-2">
			for _, c := range candidates {
				<label class="flex items-center gap-2 text-sm">
					<input type="radio" name="candidate_id" value={ c.ID } required class="h-4 w-4"/>
					<span class="font-medium">{ c.Name }</span>
				</label>
			}
		</div>
		<button type="submit" class="mt-4 rounded-md bg-slate-900 px-3 py-1.5 text-sm font-semibold text-white hover:bg-slate-700">Vote</button>
	</form>
}
