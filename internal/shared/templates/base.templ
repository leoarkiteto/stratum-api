package templates

import (
	"github.com/leoarkiteto/stratum/internal/shared/model"
)

templ Base(title string, user *model.User) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } — Stratum</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<script src="/static/htmx.min.js" defer></script>
		</head>
		<body class="min-h-screen bg-slate-100 text-slate-900 antialiased">
			@Navbar(user)
			<main class="mx-auto max-w-3xl px-4 py-10">
				{ children... }
			</main>
		</body>
	</html>
}

templ Navbar(user *model.User) {
	<nav class="border-b border-slate-200 bg-white">
		<div class="mx-auto flex h-14 max-w-3xl items-center justify-between px-4">
			<a href="/" class="text-lg font-semibold tracking-tight">Stratum</a>
			<div class="flex items-center gap-4 text-sm">
				if user != nil {
					<span class="text-slate-600">{ user.Name }</span>
					<form action="/logout" method="post" class="m-0">
						<button type="submit" class="rounded-md border border-slate-300 px-3 py-1.5 font-medium hover:bg-slate-50">Log out</button>
					</form>
				} else {
					<a href="/login" class="font-medium hover:text-slate-700">Log in</a>
					<a href="/register" class="rounded-md bg-slate-900 px-3 py-1.5 font-medium text-white hover:bg-slate-700">Sign up</a>
				}
			</div>
		</div>
	</nav>
}
