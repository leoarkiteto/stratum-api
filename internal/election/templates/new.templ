package electiontemplates

import (
	"github.com/leoarkiteto/stratum/internal/model"
	"github.com/leoarkiteto/stratum/internal/web/templates"
)

templ NewPage(user *model.User, csrf string, title string, description string, transitionDays string, errMsg string) {
	@templates.Base("New election", user) {
		<div class="mx-auto w-full max-w-lg">
			<h1 class="text-2xl font-semibold tracking-tight">New syndic election</h1>
			<p class="mt-1 text-sm text-slate-600">Open nominations for the next syndic. Owners and the current syndic can register as candidates.</p>
			@NewForm(csrf, title, description, transitionDays, errMsg)
		</div>
	}
}

templ NewForm(csrf string, title string, description string, transitionDays string, errMsg string) {
	<form id="new-election-form" hx-post="/elections" hx-target="#new-election-form" hx-swap="outerHTML" method="post" class="mt-8 space-y-4">
		<input type="hidden" name="csrf" value={ csrf }/>
		if errMsg != "" {
			<div class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">{ errMsg }</div>
		}
		<div>
			<label for="title" class="block text-sm font-medium text-slate-700">Title</label>
			<input id="title" name="title" type="text" required maxlength="200" value={ title }
				class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none"/>
		</div>
		<div>
			<label for="description" class="block text-sm font-medium text-slate-700">Description</label>
			<textarea id="description" name="description" rows="4" maxlength="2000" placeholder="Optional context for residents…"
				class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none">{ description }</textarea>
		</div>
		<div>
			<label for="transition_days" class="block text-sm font-medium text-slate-700">Transition period (days)</label>
			<input id="transition_days" name="transition_days" type="number" min="1" max="90" required value={ transitionDays }
				class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none"/>
			<p class="mt-1 text-xs text-slate-500">After the election closes, the winner takes office once this handover period ends (default 7 days).</p>
		</div>
		<button type="submit" class="rounded-md bg-slate-900 px-3 py-2 text-sm font-semibold text-white hover:bg-slate-700">Create election</button>
	</form>
}
