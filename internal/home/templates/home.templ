package hometemplates

import (
	"github.com/leoarkiteto/stratum/internal/shared/model"
	"github.com/leoarkiteto/stratum/internal/shared/templates"
)

templ LandingPage() {
	@templates.Base("Home", nil) {
		<div class="py-16 text-center">
			<h1 class="text-4xl font-bold tracking-tight">Welcome to Stratum</h1>
			<p class="mx-auto mt-4 max-w-xl text-lg text-slate-600">Your condominium's portal for finances, maintenance, meetings and voting — all in one place.</p>
			<div class="mt-8 flex items-center justify-center gap-4">
				<a href="/register" class="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700">Get started</a>
				<a href="/login" class="rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold hover:bg-slate-50">Log in</a>
			</div>
		</div>
	}
}

templ DashboardPage(user *model.User) {
	@templates.Base("Dashboard", user) {
		<div>
			<h1 class="text-2xl font-semibold tracking-tight">Dashboard</h1>
			<p class="mt-1 text-sm text-slate-600">Signed in as { user.Email }.</p>
			<div id="hello" hx-get="/dashboard/hello" hx-trigger="load" class="mt-8 rounded-md border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700">
				<p>Loading…</p>
			</div>
		</div>
	}
}

templ Hello(user *model.User) {
	<p>Hello, <span class="font-medium">{ user.Name }</span> — you are signed in as <span class="font-medium">{ user.Role }</span>.</p>
}
