# Copy to your environment (export these vars or use your shell profile).
# Do not commit real values. The app reads them from the environment only.

# Postgres connection string (required)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stratum?sslmode=disable

# JWT signing secret (required, min 32 chars) — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Optional, with defaults:
# HTTP_ADDR=:8080
# JWT_TTL=24h
# JWT_ISSUER=stratum-backend
# MIGRATIONS_DIR=migrations
