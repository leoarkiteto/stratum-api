# Copy to your environment (export these vars or use your shell profile).
# Do not commit real values. The app reads them from the environment only.

# Postgres connection string (required)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stratum?sslmode=disable

# Password pepper (required, min 32 chars) — used as the HMAC-SHA256 key before
# Argon2id. Generate with: openssl rand -hex 32
PASSWORD_PEPPER=change-me-to-a-long-random-string

# Optional, with defaults:
# HTTP_ADDR=:8080
# SESSION_TTL=24h
# COOKIE_SECURE=false      # set to "true" behind HTTPS in production
# MIGRATIONS_DIR=migrations
